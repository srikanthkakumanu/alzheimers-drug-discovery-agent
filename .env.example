# NeuroQuest local placeholders — copy to .env (git-ignored). Never commit credentials.
# Nothing reads .env yet; the future app loads it via pydantic-settings (TD-03).

# --- Mode and budget ---
NEUROQUEST_DATA_MODE=synthetic-demonstration
NEUROQUEST_LLM_TIER=economical
# Blank means unset, not unlimited; no budget is enforced yet.
NEUROQUEST_MONTHLY_BUDGET_USD=

# --- LLM provider: OpenAI (TD-05) ---
OPENAI_API_KEY=
# Model IDs per tier; choose from OpenAI's current model list at implementation.
NEUROQUEST_MODEL_ECONOMICAL=
NEUROQUEST_MODEL_CAPABLE=
NEUROQUEST_MODEL_ESCALATION=

# --- Tracing and evaluation: LangSmith (TD-08) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neuroquest

# --- Optional web search: Tavily (disabled until reviewed; results are leads, not evidence) ---
TAVILY_API_KEY=

# --- Optional literature lookup (future; not an MCP server) ---
NCBI_EMAIL=
NCBI_API_KEY=

# --- Not used by the selected stack ---
# Disabled integrations in config/mcp.json.
VECTORSTORE_URL=
VECTORSTORE_API_KEY=
LABDATA_URL=
LABDATA_API_KEY=
