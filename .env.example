# NeuroQuest local placeholders — copy to .env (git-ignored). Never commit credentials.
# The app (src/neuroquest/settings.py) loads this via pydantic-settings; Claude never reads it.

# --- Mode and budget ---
NEUROQUEST_DATA_MODE=synthetic-demonstration
NEUROQUEST_LLM_TIER=economical
# Per-run cap enforced by the app (USD). Monthly cap is advisory and not enforced.
NEUROQUEST_RUN_BUDGET_USD=0.10
NEUROQUEST_MONTHLY_BUDGET_USD=

# --- LLM providers (ADR-022): low-cost, OpenAI-compatible endpoints ---
# Model IDs are "<provider>:<model>" with provider groq, google, or mistral; a bare ID means OpenAI.
GROQ_API_KEY=
# GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
NEUROQUEST_MODEL_ECONOMICAL=groq:llama-3.1-8b-instant
NEUROQUEST_MODEL_CAPABLE=google:gemini-2.5-flash-lite
NEUROQUEST_MODEL_ESCALATION=mistral:mistral-small-latest
# Paid-tier USD per 1M tokens per model ID (verify against each provider's price page).
# Required for the budget check; free tiers cost less, so these are an upper bound.
NEUROQUEST_MODEL_PRICES='{"groq:llama-3.1-8b-instant":{"input":0.05,"cached_input":0.05,"output":0.08},"google:gemini-2.5-flash-lite":{"input":0.10,"cached_input":0.025,"output":0.40},"mistral:mistral-small-latest":{"input":0.10,"cached_input":0.10,"output":0.30}}'
# Optional overrides
# NEUROQUEST_REPO_ROOT=
# NEUROQUEST_STATE_DIR=var
# NEUROQUEST_OFFLINE=false

# --- Tracing and evaluation: LangSmith (TD-08) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neuroquest

# --- Optional web search: Tavily (disabled until reviewed; results are leads, not evidence) ---
TAVILY_API_KEY=

# --- Optional literature lookup (future; not an MCP server) ---
NCBI_EMAIL=
NCBI_API_KEY=

# --- Not used by the selected stack ---
# Disabled integrations in config/mcp.json.
VECTORSTORE_URL=
VECTORSTORE_API_KEY=
LABDATA_URL=
LABDATA_API_KEY=
