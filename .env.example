# NeuroQuest local placeholders — never commit credentials.
# No runtime reads this file. See README.md before configuring future integrations.
NEUROQUEST_DATA_MODE=synthetic-demonstration
NEUROQUEST_LLM_TIER=economical
# Optional advisory budget; blank means unset, not an enforced spending limit.
NEUROQUEST_MONTHLY_BUDGET_USD=
# Future optional provider credential; not needed for repository validation.
ANTHROPIC_API_KEY=
# Optional NCBI contact/key for a future literature client; not an MCP server.
NCBI_EMAIL=
NCBI_API_KEY=
# Future integrations remain disabled in config/mcp.json.
VECTORSTORE_URL=
VECTORSTORE_API_KEY=
LABDATA_URL=
LABDATA_API_KEY=
